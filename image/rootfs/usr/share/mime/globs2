# Minimal MIME globs for GLib's xdgmime (no shared-mime-info in the image). WebKit asks GLib
# for the type of file:// URLs; without this the local status page is text/plain and shows
# as source. Format: weight:type:glob.
50:text/html:*.html
50:text/html:*.htm
50:text/css:*.css
50:text/javascript:*.js
50:application/json:*.json
50:image/png:*.png
50:image/jpeg:*.jpg
50:image/jpeg:*.jpeg
50:image/svg+xml:*.svg
50:image/webp:*.webp
50:font/woff2:*.woff2
