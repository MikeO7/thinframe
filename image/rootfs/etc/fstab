# <file system>			<mount pt>		<type>	<options>			<dump> <pass>
/dev/root			/			ext4	ro,noatime,noauto		0 0
proc				/proc			proc	defaults			0 0
devpts				/dev/pts		devpts	defaults,gid=5,mode=620,ptmxmode=0666 0 0
tmpfs				/dev/shm		tmpfs	mode=1777			0 0
tmpfs				/tmp			tmpfs	mode=1777,size=64m		0 0
tmpfs				/run			tmpfs	mode=0755,nosuid,nodev		0 0
sysfs				/sys			sysfs	defaults			0 0
# p4: survives OS updates. Seeded by post-image.sh, grown to the card by `tfctl boot`.
# Checked by `tfctl boot fsck` (inittab) just before `mount -a`; BusyBox ignores <pass>.
# Not LABEL=: `tfctl boot fsck` links /dev/thinframe-{data,boot} to p4/p1 of the disk with our
# MBR signature, so neither mount can land on an eMMC partition that shares a label.
/dev/thinframe-data		/data			ext4	noatime				0 0
/dev/thinframe-boot		/boot			vfat	ro,noatime,umask=0022		0 0
/data/ssh			/etc/dropbear		none	bind				0 0
/data/iwd			/var/lib/iwd		none	bind				0 0
