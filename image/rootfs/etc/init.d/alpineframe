#!/sbin/openrc-run
# The kiosk. afctl spawns cog on DRM and restarts it; supervise-daemon restarts afctl.
description="alpineframe kiosk"
supervisor=supervise-daemon
command=/usr/bin/afctl
command_args="kiosk"
command_user="frame"
output_log=/var/log/alpineframe.log
error_log=/var/log/alpineframe.log
respawn_delay=3
respawn_max=0
depend() {
	need seatd udev
	after net
}
start_pre() {
	checkpath -f -o frame /var/log/alpineframe.log
	checkpath -d -m 0700 -o frame /run/user/1000
}
