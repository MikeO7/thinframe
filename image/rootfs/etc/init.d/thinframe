#!/sbin/openrc-run
# The kiosk. tfctl spawns cog on DRM and restarts it; supervise-daemon restarts tfctl.
description="thinframe kiosk"
supervisor=supervise-daemon
command=/usr/bin/tfctl
command_args="kiosk"
command_user="frame"
output_log=/var/log/thinframe.log
error_log=/var/log/thinframe.log
respawn_delay=3
respawn_max=0
depend() {
	need seatd udev
	after net
}
start_pre() {
	checkpath -f -o frame /var/log/thinframe.log
	checkpath -d -m 0700 -o frame /run/user/1000
}
