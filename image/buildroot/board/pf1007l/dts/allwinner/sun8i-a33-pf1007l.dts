// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Humblestead HM-PF1007-BK digital photo frame.
 * Board: EFERCRO PF1007L_MB_V1.0. Vendor fex: [product] machine = "U708HC".
 * SoC: Allwinner A33. Panel: 10.1" 800x1280 MIPI-DSI (JD9365DA class).
 *
 * Buildroot compiles this file with the v7.2.10 kernel (BR2_LINUX_KERNEL_CUSTOM_DTS_DIR)
 * and post-image.sh puts the DTB on PFBOOT; extlinux boots every slot with it.
 * Panel, touch, Wi-Fi, PMIC and the USB gadget are proven on the frame (docs/log.md);
 * values marked UNCONFIRMED or TODO are not. docs/hardware.md has the board facts.
 *
 * Source of each value:
 *   [fex]  sys_config.fex of THIS frame (section and key are given)
 *   [pwr]  the vendor lcd.ko, read in disassembly, not measured
 *   [ref]  mainline sun8i-reference-design-tablet.dtsi value, NOT confirmed
 *          on this board ("UNCONFIRMED - reference design")
 *   [wifi] the vendor rf_pm / wifi_pm modules, read in disassembly, not measured
 *   [touch] the vendor gslX680new.ko, static analysis
 *   [cpu]  the vendor kernel and arisc firmware
 *   TODO   open point
 *
 * No serial console: UART0 is on the SD pins (PF2/PF4) and R_UART's PL2 is the Wi-Fi
 * chip-enable output. The console is the USB-C serial gadget (ttyGS0, extlinux.conf.in).
 * The eMMC (MMC2) stays disabled: Android lives there and the frame must stay recoverable
 * by removing the card (CLAUDE.md).
 */

/dts-v1/;
#include "sun8i-a33.dtsi"
#include "sun8i-reference-design-tablet.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Humblestead HM-PF1007-BK (EFERCRO PF1007L)";
	/* "efercro" is a PLACEHOLDER vendor prefix (not in vendor-prefixes.yaml). */
	compatible = "efercro,pf1007l", "allwinner,sun8i-a33";

	aliases {
		mmc0 = &mmc0;	/* MicroSD */
		mmc1 = &mmc1;	/* SDIO Wi-Fi */
		mmc2 = &mmc2;	/* eMMC */
		/*
		 * The reference dtsi sets serial0 = &r_uart (PL2/PL3). On this
		 * board PL2 is an output of the Wi-Fi power code
		 * ([fex] [rf_para] chip_en = PL02) and [s_uart0] s_uart_used = 0.
		 * Do not put a UART there.
		 */
		/delete-property/ serial0;
	};

	/*
	 * Console. The vendor console was ttyS0 = UART0, 115200. UART0 is on
	 * PF2/PF4, the SD-card pins, so there is NO serial console and no
	 * stdout-path. Do not put console=ttyS0 on the command line: no UART
	 * probes, so the name has no device.
	 */
	chosen {
		/delete-property/ stdout-path;
	};

	/*
	 * Wi-Fi power, vendor order [wifi]:
	 *   kernel boot: DLDO1 on, DLDO2 on, AXP GPIO0 = 1
	 *   Wi-Fi on:    PL2 (chip_en) = 1, wait, PL6 (wl_reg_on) = 1
	 * The two pins are active high ([fex] [rf_para] chip_en = PL02,
	 * [wifi_para] wl_reg_on = PL06, both outputs, default 0).
	 *
	 * The wait between PL2 and PL6: two readings of the same vendor loop
	 * (5 x const_udelay(0x066665b0)) gave 5 ms and about 125 ms.
	 * The constant is 1000 * ((2199023 * HZ) >> 11) with HZ = 100, which
	 * is udelay(1000) on 32-bit ARM. The vendor kernel has CONFIG_HZ=100
	 * (its own embedded config). So the loop is mdelay(5) = 5 ms.
	 * The 150 ms below is longer than the two readings. It is safe for the
	 * 125 ms reading. It is safe for the 5 ms reading if the chip has
	 * only a MINIMUM time between the two pins (UNCONFIRMED, no datasheet).
	 *
	 * "mmc-pwrseq-simple" sets all its reset GPIOs in one call, so it
	 * cannot make this wait. PL2 is thus a fixed regulator with a start-up
	 * delay, and it is the vmmc supply of the SDIO host. The MMC core
	 * turns on vmmc (PL2 high, 150 ms), then vqmmc, waits 10 ms, and then
	 * runs the pwrseq (PL6 high, post-power-on delay).
	 */
	reg_wifi_chip_en: regulator-wifi-chip-en {
		compatible = "regulator-fixed";
		regulator-name = "wifi-chip-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&r_pio 0 2 GPIO_ACTIVE_HIGH>; /* PL2 */
		enable-active-high;
		startup-delay-us = <150000>;
		vin-supply = <&reg_dldo1>;
	};

	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* "reset" is the opposite of "enable": ACTIVE_LOW. */
		reset-gpios = <&r_pio 0 6 GPIO_ACTIVE_LOW>; /* PL6 wl_reg_on */
		/*
		 * GUESS. The vendor kernel has no wait after PL6. 200 ms is the
		 * value of the mainline Q8 tablets. The AIC driver needs the
		 * card on the bus before it loads.
		 */
		post-power-on-delay-ms = <200>;
	};
};

/* ------------------------------------------------------------------ */
/* CPU                                                                */
/* ------------------------------------------------------------------ */

/*
 * CPU supply [cpu]: the vendor kernel (sunxi_cpufreq, "axp22_dcdc3") and
 * the vendor arisc firmware (DVFS writes AXP register 0x23) use DCDC3 for
 * the CPU. DCDC2 is the system / DDR-frequency rail. This is VERIFIED in the
 * two binaries of this frame. It is NOT measured on the board.
 * sun8i-reference-design-tablet.dtsi has cpu-supply = DCDC2: wrong for this
 * board, so the property is removed below.
 *
 * No cpu-supply: cpufreq changes the frequency only. DCDC2 and DCDC3 stay
 * at 1.2 V (the fex boot value, [power_sply]). 1.2 V is the voltage of the
 * highest OPP in sun8i-a33.dtsi (1.008 GHz) and of [fex] [dvfs_table] LV4.
 * All lower OPPs are safe at 1.2 V. The cost is more heat at low frequency.
 * This is safe if DCDC3 is the CPU rail, and also if it is not.
 * TODO: cpu-supply = <&reg_dcdc3> with a 1.04 to 1.20 V range once a check on
 * the frame shows AXP register 0x23 follows the CPU frequency and 0x22 does not.
 */
&cpu0 {
	/delete-property/ cpu-supply;
};

/* ------------------------------------------------------------------ */
/* Display: DE -> TCON0 -> DSI -> panel                               */
/* ------------------------------------------------------------------ */

/*
 * Backlight. Overrides the reference node.
 * [fex] [lcd0_para] lcd_pwm_ch = 0, [pwm0_para] PH00.
 * [fex] lcd_pwm_freq = 50000 Hz -> period = 1e9 / 50000 = 20000 ns.
 * [fex] lcd_pwm_pol = 0 -> normal polarity (BSP pwm-sunxi.c:
 *       PWM_POLARITY_NORMAL = active high). The reference dtsi has
 *       50000 ns and PWM_POLARITY_INVERTED: not valid for this board.
 * [fex] lcd_bl_en = PH06, output, value 1 -> active high.
 * [ref] brightness-levels, default-brightness-level, power-supply.
 *       ([fex] [disp_init] lcd0_backlight = 197 of 255 = 77 %.)
 */
&backlight {
	pwms = <&pwm 0 20000 0>;
	enable-gpios = <&pio 7 6 GPIO_ACTIVE_HIGH>; /* PH6 */
};

&de {
	status = "okay";
};

/*
 * No pinctrl: the DSI lanes are dedicated pins. tcon0_out endpoint@1 -> dsi
 * is in sun8i-a33.dtsi. There is no endpoint@0 (RGB/LVDS): sun4i_rgb_init()
 * then prints "No panel or bridge found... RGB output disabled" and returns 0.
 */
&tcon0 {
	status = "okay";
};

&dphy {
	status = "okay";
};

&dsi {
	/*
	 * TODO: the regulator that feeds the SoC pin VCC-DSI is NOT known.
	 * Placeholder = DCDC1 (always on), from the example in the binding
	 * allwinner,sun6i-a31-mipi-dsi.yaml (A33, dsi@1ca0000). Candidates on
	 * this board: DCDC1, DC1SW (lcd_power), ELDO3 (lcd_power1).
	 */
	vcc-dsi-supply = <&reg_dcdc1>;
	status = "okay";

	panel@0 {
		/*
		 * PLACEHOLDER compatible, from [fex] lcd_driver_name =
		 * "yhk_zr789_sq9365_101". Needs patches/linux/0001-drm-panel-*.patch.
		 */
		compatible = "yhk,zr789-sq9365-101", "jadard,jd9365da-h3";
		reg = <0>;
		/*
		 * [fex] lcd_power = "axp22_dc1sw", lcd_power1 = "axp22_eldo3".
		 * [pwr] the vendor turns on DC1SW, waits 10 ms, turns on ELDO3.
		 * Off: ELDO3, then DC1SW.
		 * The driver turns on "vccio" first, then "vdd", and turns them
		 * off in the opposite order. This mapping gives the vendor
		 * order. Which rail is the electrical VDD and which is VCCIO is
		 * NOT known (both are 3.3 V in the fex). TODO: schematic or
		 * meter.
		 */
		vccio-supply = <&reg_dc1sw>;
		vdd-supply = <&reg_eldo3>;
		/*
		 * [fex] lcd_gpio_0 = PH07, output, value 1.
		 * [pwr] the vendor code holds the pin at 1 to run and pulses it
		 * to 0 for a reset -> active low.
		 */
		reset-gpios = <&pio 7 7 GPIO_ACTIVE_LOW>; /* PH7 */
		backlight = <&backlight>;
		/* The panel is 800x1280 (portrait). The frame stands in landscape. */
		rotation = <90>;
	};
};

/* ------------------------------------------------------------------ */
/* Touch: Silead GSL on TWI0                                          */
/* ------------------------------------------------------------------ */

/*
 * The reference dtsi gives: i2c0 at 400 kHz, touchscreen@40, INT PB5
 * (falling edge), power-gpios PH1. The fex agrees:
 * [fex] [ctp_para] ctp_twi_id = 0, ctp_twi_addr = 0x40,
 *       ctp_int_port = PB05, ctp_wakeup = PH01 (output, value 1),
 *       ctp_power_ldo = "axp22_ldoio1", ctp_power_ldo_vol = 3300.
 * [touch] ctp_name = "gsl_m86_hd" selects table entry 4 of the vendor
 *       module. tfctl touchfw extracts its firmware array from the frame's
 *       own Android image as gsl_m86_hd.fw (36960 bytes, mainline silead
 *       layout) and installs it under /usr/lib/firmware/silead/. The driver
 *       stops its probe if the file is absent.
 * [touch] Chip model: NOT proved, best estimate GSL1680. silead.c uses the
 *       same code for all "silead,gsl*" names when firmware-name is set.
 * [touch] Size 960 x 640 = 15 x 10 sensor lines x 64: UNCONFIRMED. The fex
 *       values (1024 x 600, revert X and Y) describe the output of the
 *       vendor point library, not the raw range, so they are NOT used here.
 * No swap and no inversion here: tfctl maps the axes (docs/hardware.md).
 * [touch] silead,max-fingers = 5 (vendor limit). The v7.2.10 driver does
 *       not read the property; the binding permits it.
 * avdd and vddio: the fex gives one LDO. Which chip pin it feeds is not
 * known. The driver enables the two supplies together.
 */
&touchscreen {
	compatible = "silead,gsl1680";
	reg = <0x40>;
	firmware-name = "gsl_m86_hd.fw";
	avdd-supply = <&reg_ldo_io1>;
	vddio-supply = <&reg_ldo_io1>;
	touchscreen-size-x = <960>;
	touchscreen-size-y = <640>;
	silead,max-fingers = <5>;
	status = "okay";
};

/* ------------------------------------------------------------------ */
/* Accelerometer on TWI1: Silan SC7A20 (verified by I2C scan)         */
/* ------------------------------------------------------------------ */

/*
 * [fex] [gsensor_para] gsensor_twi_id = 1, gsensor_twi_addr = 0x19,
 *       gsensor_int1 = PB06.
 * [fex] [gsensor_list_para] (auto-detect list): stk831x, sc7a20, mir3da, msa.
 * Android's sensors HAL names this device "sc7a20 detect Accelerometer".
 * A test boot bound the stock st_accel_i2c driver at 0x19 and produced all
 * three raw IIO axes. Disabled until the axes are calibrated and tfctl has
 * a use for them. No interrupt is needed for a raw-read test.
 */
&i2c1 {
	accelerometer@19 {
		compatible = "silan,sc7a20";
		reg = <0x19>;
		status = "disabled";
	};
};

/* ------------------------------------------------------------------ */
/* Storage                                                            */
/* ------------------------------------------------------------------ */

/*
 * MicroSD. The reference dtsi already has: vmmc = DCDC1, 4-bit, cd PB4.
 * [fex] [mmc0_para] sdc_buswidth = 4, sdc_det = PB04,
 *       sdc_power_supply = "axp22_dcdc1". The fex agrees.
 * [ref] card-detect polarity (active low).
 * [fex] [uart_para] the debug UART0 is on PF2/PF4 = SD CLK and SD D3.
 *       UART0 and the SD card cannot be used at the same time.
 */

/*
 * SDIO Wi-Fi (AIC8800DC; no mainline driver; the out-of-tree driver in
 * package/aic8800 binds by SDIO ID and reads no DT property).
 * [fex] [wifi_para] wifi_sdc_id = 1. [mmc1_para] PG00-PG05, 4-bit,
 *       sdc_detmode = 4 (no card-detect pin).
 * [fex] [rf_para] module_power1 = "axp22_dldo1" 3.3 V,
 *       module_power2 = "axp22_dldo2" 3.3 V.
 * Which rail is the IO supply is NOT known. See the power note at the
 * wifi_pwrseq node and at reg_dldo1 / reg_dldo2.
 * keep-power-in-suspend: the AIC driver returns -EINVAL from its suspend
 * hook without MMC_PM_KEEP_POWER.
 * [fex] wl_host_wake = PL07 (input). Not used: the driver build uses the
 * in-band SDIO interrupt.
 */
&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pg_pins>;
	vmmc-supply = <&reg_wifi_chip_en>;	/* PL2, fed from DLDO1 */
	vqmmc-supply = <&reg_dldo2>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	keep-power-in-suspend;
	status = "okay";

	wifi: wifi@1 {
		reg = <1>;
	};
};

/*
 * eMMC. Android is on it. DISABLED: the frame boots from SD only and must
 * stay recoverable by removing the card (CLAUDE.md).
 * [fex] [mmc2_para] sdc_buswidth = 8, PC05/PC06/PC08-PC15, emmc_rst = PC16,
 *       sdc_power_supply = "axp22_dcdc1".
 * [fex] [mmc2_para] sdc_used = 0 in the stored fex. The vendor bootloader
 *       probably sets it when it boots from eMMC (UNCONFIRMED).
 * [fex] [card2_boot_para] card_line = 4: the boot code uses 4 bits.
 * Another PF1007L unit had a U-Boot hang at 8 bits. If it is ever read
 * and shows I/O errors: bus-width = <4>; max-frequency = <26000000>.
 */
&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	vmmc-supply = <&reg_dcdc1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status = "disabled";
};

/* ------------------------------------------------------------------ */
/* PMIC: AXP22x on RSB                                                */
/* ------------------------------------------------------------------ */

/*
 * [fex] [pmu1_para] pmu_used = 1, [s_rsb0] s_rsb_used = 1, PL00/PL01.
 * The reference dtsi gives "x-powers,axp223" at RSB address 0x3a3.
 * TODO: the fex says "axp22" only. AXP223 is the RSB part of the family,
 * but read the chip marking or the kernel log to confirm.
 *
 * The frame gets its power FROM the USB host. It must not drive VBUS.
 * "x-powers,drive-vbus-en" makes axp20x-regulator.c set the N_VBUSEN pin
 * to an output (axp20x-regulator.c:1730-1733), so remove it.
 * [fex] [pmu1_para] pmu_vbusen_func = 1 ("as an input" in the BSP fex
 * comments) agrees, but that value is also in the BSP file of a board that
 * does drive VBUS, so it is weak evidence.
 */
&axp22x {
	/delete-property/ x-powers,drive-vbus-en;
	/delete-property/ drivevbus-supply;
};

&reg_drivevbus {
	status = "disabled";
};

/*
 * [fex] [rf_para] power_switch = port:power0<1><0>: AXP GPIO0, output.
 * [wifi] the vendor kernel sets it to 1 at boot (rf_pm_probe) and keeps
 * it. What it switches on the PCB is NOT known. Pin 0 of the
 * "x-powers,axp221-gpio" controller is GPIO0 (pinctrl-axp209.c).
 * reg_ldo_io0 (the LDO function of the same pin) stays disabled.
 */
&axp_gpio {
	wifi-power-switch-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wifi-power-switch";
	};
};

/* [fex] [power_sply] aldo1_vol = 3300. ([ref] has 3.0 V.) */
&reg_aldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-io";
};

/* [fex] [power_sply] aldo2_vol = 2500. */
&reg_aldo2 {
	regulator-always-on;
	regulator-min-microvolt = <2500000>;
	regulator-max-microvolt = <2500000>;
	regulator-name = "vdd-dll";
};

/* [fex] [power_sply] aldo3_vol = 3000. */
&reg_aldo3 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "vcc-pll-avcc";
};

/*
 * [fex] [power_sply] dc1sw_vol = 3300 (a switch after DCDC1).
 * [fex] [lcd0_para] lcd_power = "axp22_dc1sw".
 * [pwr] the vendor waits 10 ms after DC1SW on, before ELDO3 on. The enable
 *       delay below gives the same wait (pattern: sun50i-a64-pinetab.dts).
 */
&reg_dc1sw {
	regulator-name = "vcc-lcd";
	regulator-enable-ramp-delay = <10000>;
};

/* [fex] [power_sply] dcdc1_vol = 3300. ([ref] has 3.0 V.) */
&reg_dcdc1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-3v3";
};

/*
 * [fex] [power_sply] dcdc2_vol = 1200. Always fixed at 1.2 V.
 * [cpu] the vendor uses DCDC2 as the system rail (sunxi_ddrfreq).
 */
&reg_dcdc2 {
	regulator-always-on;
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
	regulator-name = "vdd-sys";
};

/*
 * [fex] [power_sply] dcdc3_vol = 1200. [cpu] the vendor CPU rail.
 * Fixed at 1.2 V until cpu-supply is proven (see the CPU note).
 */
&reg_dcdc3 {
	regulator-always-on;
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
	regulator-name = "vdd-cpu";
};

/* [fex] [power_sply] dcdc5_vol = 1500. Same as [ref]. */

/*
 * [fex] [rf_para] module_power1 = "axp22_dldo1", 3300000 uV.
 * [fex] [rf_para] module_power2 = "axp22_dldo2", 3300000 uV.
 * [wifi] the vendor kernel turns on the two rails at boot, before PL2 and
 * PL6, and does not turn them off in the Wi-Fi on/off code. always-on
 * gives the same order (pattern: sun8i-r16-bananapi-m2m.dts, same rails).
 */
&reg_dldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi0";
};

&reg_dldo2 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi1";
};

/*
 * [fex] [power_sply] dldo4_val = 1800. The consumer is NOT known. Not
 * always-on. If a device is dead under mainline, test regulator-always-on
 * here.
 */
&reg_dldo4 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "dldo4-1v8";
};

/* [fex] [power_sply] eldo1_vol = 2800. Consumer NOT known. Not always-on. */
&reg_eldo1 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	regulator-name = "eldo1-2v8";
};

/*
 * [fex] [power_sply] eldo3_vol = 3300.
 * [fex] [lcd0_para] lcd_power1 = "axp22_eldo3".
 */
&reg_eldo3 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-lcd-1";
};

/*
 * Kept from [ref] with no change: dc5ldo "vdd-cpus" (0.9-1.4 V, the fex has
 * no value), dcdc5 "vcc-dram" 1.5 V, ldo_io1 "vcc-touchscreen" 3.3 V
 * (= [fex] ctp_power_ldo), rtc_ldo, eldoin-supply = DCDC1,
 * ac_power_supply, battery_power_supply ([fex] pmu_battery_cap = 0: the
 * frame probably has no battery, UNCONFIRMED), LRADC volume keys.
 */

/* ------------------------------------------------------------------ */
/* Audio: disabled until a separate, SD-safe test is available.       */
/* ------------------------------------------------------------------ */

/*
 * [fex] [audio0] says audio is present and the speaker amplifier enable
 * is PH09. Android confirms the A33 codec drives the board speaker. A PH09
 * GPIO hog was tried in a separate DTB and that boot lost its microSD root
 * device. A future audio test must start from this known-good DTB and prove
 * its pinmux does not affect storage.
 */
&dai {
	status = "disabled";
};

&codec {
	status = "disabled";
};

&sound {
	status = "disabled";
};

/* ------------------------------------------------------------------ */
/* Serial                                                             */
/* ------------------------------------------------------------------ */

/*
 * The reference dtsi enables r_uart on PL2/PL3. See the aliases note.
 * PL2 is the Wi-Fi chip_en output on this board. With r_uart disabled and
 * its pinctrl removed, the only user of PL2 in this file is the Wi-Fi power
 * node, and PL3 has no user. U-Boot keeps the same rule: its console UART
 * gets no pins at all (image/uboot, CONFIG_SUNXI_CONSOLE_NO_PINMUX).
 */
&r_uart {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "disabled";
};

/* ------------------------------------------------------------------ */
/* USB: one USB-C port. The host gives the power. Device mode only.   */
/* ------------------------------------------------------------------ */

/*
 * [fex] [usbc0] usb_port_type = 2 (OTG), usb_id_gpio = PH08,
 *       usb_det_vbus_gpio = "axp_ctrl", usb_drv_vbus_gpio = power4 (AXP).
 * The fex is a generic OTG tablet configuration. The frame is a peripheral:
 * no ID detection, no VBUS drive (the USB-C cable to the Mac is the console
 * and the fallback network, docs/update-and-ssh.md).
 * [fex] usb_det_vbus_gpio = "axp_ctrl" agrees with
 *       usb0_vbus_power-supply = <&usb_power_supply> in the reference dtsi.
 */
&usb_otg {
	dr_mode = "peripheral";
};

&usbphy {
	/delete-property/ usb0_id_det-gpios;
	/delete-property/ usb0_vbus-supply;
};
