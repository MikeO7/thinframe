# Layered over the in-tree sunxi_defconfig (v7.2.10). Option list from ormarch kernel/config-audit.md.
# Display: DSI host, D-PHY, the patched JD9365DA panel, GPU, backlight. Built in: no module order.
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
CONFIG_DRM_LIMA=y
CONFIG_PWM_SUN4I=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_CMA_SIZE_MBYTES=64
# The panel is the dashboard's: no kernel console on it, ever (TASK 15).
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# Touch: a module, because its firmware lives on the root file system.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=m
# SoC temperature (A33 THS is served by the GPADC driver).
CONFIG_MFD_SUN4I_GPADC=y
CONFIG_SUN4I_GPADC=y
# Wi-Fi base for the out-of-tree aic8800 modules.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=m
# iwd's kernel requirements (iwd README).
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
# USB-C recovery link, built in so it is up before userspace: CDC ECM (usb0) + ACM (ttyGS0).
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_GADGET=y
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_U_SERIAL_CONSOLE=y
# File systems: ext4 root slots and data, FAT PFBOOT.
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# QEMU test board (orangepi-pc, H3): its EMAC, so the image test can ssh in.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
# Memory and CPU: no swap (decisions.md), PSI on, governors for TASK 13.
# CONFIG_SWAP is not set
CONFIG_PSI=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
