# QEMU=1 image/build.sh rootfs (TASK M2): the same image for `qemu-system-arm -M virt`, where cog
# draws on virtio-gpu through Mesa's software rasteriser. Own output tree; never shipped.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINFRAME_PATH)/board/pf1007l/linux.fragment $(BR2_EXTERNAL_THINFRAME_PATH)/board/pf1007l/linux-qemu.fragment"
# Debugging aids for the sim only: gdb, unstripped binaries (needs a bigger rootfs; the slot is 1G),
# and a passwordless root login on the serial console (sim/qemu/run.sh exposes it as a socket).
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_DEBUGGER=y
# BR2_STRIP_strip is not set
BR2_TARGET_ROOTFS_EXT2_SIZE="400M"
BR2_TARGET_ENABLE_ROOT_LOGIN=y
# On-screen Wi-Fi setup (TASK 17): mac80211_hwsim radios (linux-qemu.fragment) with hostapd as the
# access points, started by qemu-overlay/etc/init.d/S35simwifi. The overlay goes after the frame's.
BR2_PACKAGE_HOSTAPD=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_THINFRAME_PATH)/../rootfs $(BR2_EXTERNAL_THINFRAME_PATH)/board/pf1007l/qemu-overlay"
# M2 A/B inside -M virt: U-Boot for QEMU's virt board runs the same boot.cmd slot logic (the
# harness swaps "mmc 0:1" for "virtio 0:1"); sim/qemu/run.sh boots it with -bios.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="qemu_arm"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINFRAME_PATH)/board/pf1007l/uboot-qemu.fragment"
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_FORMAT_BIN=y
