@@ -537,6 +537,11 @@
 extern uint8_t scanning;
 int aicwf_dbg_level = LOGERROR;
 module_param(aicwf_dbg_level, int, 0660);
+/* thinframe: the address to use when the efuse has none (tfctl netid.rs derives it per
+ * device). Without it every load made one up: 88:00:33:77 and 16 random bits. */
+static char *thinframe_mac;
+module_param_named(mac, thinframe_mac, charp, 0444);
+MODULE_PARM_DESC(mac, "Wi-Fi address when the efuse has none, aa:bb:cc:dd:ee:ff");
 #ifdef CONFIG_DYNAMIC_PWR
 int dynamic_pwr = 1;
 module_param(dynamic_pwr, int, 0660);
@@ -6036,6 +6041,14 @@
 	aicbsp_get_feature(&feature, fw_path);
 
 	get_random_bytes(&dflt_mac[4], 2);
+	if (thinframe_mac) {
+		u8 tf_mac[ETH_ALEN];
+
+		if (mac_pton(thinframe_mac, tf_mac) && is_valid_ether_addr(tf_mac))
+			memcpy(dflt_mac, tf_mac, ETH_ALEN);
+		else
+			AICWFDBG(LOGERROR, "mac=%s is not a unicast address, using a random one\n", thinframe_mac);
+	}
